// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator python {
  provider             = "prisma-client-py"
  interface            = "sync"
  recursive_type_depth = -1
  previewFeatures      = ["fullTextSearch", "filteredRelationCount"]
}

generator js {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "filteredRelationCount"]
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model StaffUser {
  id                   Int                 @id @default(autoincrement())
  name                 String
  email                String              @unique
  googleAccessToken    String
  googleRefreshToken   String
  googleIdToken        String
  profilePicture       String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @default(now())
  groups               String[]
  isEnabled            Boolean             @default(true)
  issuedInfractions    ClubInfraction[]
  issuedModerationLogs ClubModerationLog[]
  issuedStaffUserLogs  StaffUserLog[]      @relation("createdBy")
  staffUserLogs        StaffUserLog[]      @relation("staffUser")
}

model StaffUserLog {
  id          Int              @id @default(autoincrement())
  staffUser   StaffUser?       @relation(name: "staffUser", fields: [staffUserId], references: [id])
  staffUserId Int?
  createdAt   DateTime         @default(now())
  createdBy   StaffUser        @relation(name: "createdBy", fields: [createdById], references: [id])
  createdById Int
  logType     StaffUserLogType
  notes       String

  @@index([createdAt(ops: TimestampMinMaxMultiOps)], type: Brin)
  @@index([staffUserId])
  @@index([createdById])
  @@index([logType])
}

model Club {
  id             Int            @id @default(autoincrement())
  name           String
  requestedName  String?
  nameRequestId  Int?           @unique
  nameStatus     ClubNameStatus @default(NAME_REQUESTED)
  ownerAccountId Int
  ownerAvId      Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now())
  deletedAt      DateTime?

  clubIcon Json // main i give up

  motd        String?
  capacity    Int
  maxBoosters Int        @default(1)
  level       Int        @default(1)
  dailyCoins  Int
  clubXp      Int
  clubCoins   Float
  jellybeans  Int
  toons       ClubToon[]

  clubSettings Json?
  boosters     Json[]
  ownedItems   Int[]
  clubTasks    Json[]
  logs         ClubLog[]

  infractions    ClubInfraction[]
  moderationLogs ClubModerationLog[]

  @@index([createdAt(ops: TimestampMinMaxMultiOps)], type: Brin)
  @@index([updatedAt(ops: TimestampMinMaxMultiOps)], type: Brin)
  @@index([deletedAt(ops: TimestampMinMaxMultiOps)], type: Brin)
  @@index([nameRequestId])
}

model ClubToon {
  id          Int       @id @default(autoincrement())
  club        Club      @relation(fields: [clubId], references: [id])
  clubId      Int
  avId        Int
  invitedBy   Int
  requestedAt DateTime  @default(now())
  joinedAt    DateTime?
  updatedAt   DateTime  @default(now())
  deletedAt   DateTime?
  rankId      Int?

  @@unique([clubId, avId])
  @@index([requestedAt(ops: TimestampMinMaxMultiOps)], type: Brin)
  @@index([joinedAt(ops: TimestampMinMaxMultiOps)], type: Brin)
  @@index([updatedAt(ops: TimestampMinMaxMultiOps)], type: Brin)
  @@index([deletedAt(ops: TimestampMinMaxMultiOps)], type: Brin)
  @@index([clubId])
  @@index([avId])
}

model ClubLog {
  id        Int         @id @default(autoincrement())
  club      Club        @relation(fields: [clubId], references: [id])
  clubId    Int
  createdAt DateTime    @default(now())
  logType   ClubLogType
  data      Json

  @@index([createdAt(ops: TimestampMinMaxMultiOps)], type: Brin)
  @@index([clubId])
  @@index([logType])
}

model ClubInfraction {
  id                 Int                 @id @default(autoincrement())
  club               Club                @relation(fields: [clubId], references: [id])
  clubId             Int
  createdAt          DateTime            @default(now())
  createdBy          StaffUser           @relation(fields: [createdById], references: [id])
  createdById        Int
  infractionType     ClubInfractionType
  expiresAt          DateTime?
  repealedAt         DateTime?
  reason             String
  supportingEvidence String              @default("")
  moderationLogs     ClubModerationLog[]

  @@index([createdAt(ops: TimestampMinMaxMultiOps)], type: Brin)
  @@index([clubId])
  @@index([createdById])
  @@index([infractionType])
}

model ClubModerationLog {
  id               Int                   @id @default(autoincrement())
  club             Club                  @relation(fields: [clubId], references: [id])
  clubId           Int
  clubInfraction   ClubInfraction?       @relation(fields: [clubInfractionId], references: [id])
  clubInfractionId Int?
  createdAt        DateTime              @default(now())
  createdBy        StaffUser             @relation(fields: [createdById], references: [id])
  createdById      Int
  logType          ClubModerationLogType
  notes            String

  @@index([createdAt(ops: TimestampMinMaxMultiOps)], type: Brin)
  @@index([clubId])
  @@index([clubInfractionId])
  @@index([createdById])
  @@index([logType])
}

enum ClubNameStatus {
  NAME_REQUESTED
  NAME_APPROVED
  NAME_DENIED
  NAME_FAILED
  NAME_CHANGING
}

enum ClubInfractionType {
  WARNING
  MUTE
  JOIN_LOCK
  MOTD_EDIT_LOCK
  DISBAND
}

enum ClubLogType {
  CLUB_CREATED

  JOINED_CLUB
  LEFT_CLUB
  INVITED_TO_CLUB
  ACCEPTED_CLUB_JOIN_INVITATION
  KICKED_FROM_CLUB

  USER_RANK_CHANGED
  SETTINGS_UPDATED
  LEADER_TRANSFERRED

  EARNED_JELLYBEANS
  EARNED_CLUB_XP
  CLUB_PROMOTED

  BOUGHT_ITEM
  USED_ITEM

  CLUB_NAME_APPROVED
  CLUB_NAME_REJECTED
  CLUB_NAME_SUBMITTED
  CLUB_NAME_REVOKED

  CLUB_MOTD_UPDATED
  CLUB_MOTD_REVOKED

  CLUB_TASK_COMPLETE
  CLUB_TASK_REROLLED

  CLUB_OWNER_TRANSFERRED
  CLUB_FORCE_OWNER_TRANSFERRED
  CLUB_DISBANDED
  CLUB_FORCE_DISBANDED
  CLUB_REINSTATED
}

enum ClubModerationLogType {
  INFRACTION
  INFO
}

enum StaffUserLogType {
  STAFF_EDITED
}
